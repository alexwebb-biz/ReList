# =============================================================================
# RELIST - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# For production: Update DOMAIN, NODE_ENV, and LETSENCRYPT_EMAIL
# DO NOT commit .env to git - it contains secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE - Cloud Database (REQUIRED)
# -----------------------------------------------------------------------------
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# AUTHENTICATION (REQUIRED)
# -----------------------------------------------------------------------------
# Generate secure random strings for these:
# Example: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars

# -----------------------------------------------------------------------------
# DOMAIN CONFIGURATION (REQUIRED FOR PRODUCTION)
# -----------------------------------------------------------------------------
# Your domain name (e.g., relist.yourdomain.com or your.ec2.ip.address)
DOMAIN=localhost

# Set to 'production' for SSL, 'development' for HTTP only
NODE_ENV=development

# Email for Let's Encrypt SSL certificates (production only)
LETSENCRYPT_EMAIL=your-email@example.com

# -----------------------------------------------------------------------------
# FRONTEND/BACKEND URLs (AUTO-CONFIGURED - DO NOT CHANGE)
# -----------------------------------------------------------------------------
# These will be automatically set based on DOMAIN and NODE_ENV by docker-compose
FRONTEND_URL=http://localhost
CLIENT_URL=http://localhost

# -----------------------------------------------------------------------------
# STRIPE - Payments (OPTIONAL)
# -----------------------------------------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# -----------------------------------------------------------------------------
# TELEGRAM - Notifications (OPTIONAL)
# -----------------------------------------------------------------------------
# Create bot at: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# EBAY API - eBay Integration (OPTIONAL)
# -----------------------------------------------------------------------------
# Get credentials from: https://developer.ebay.com/my/keys
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=PRODUCTION
EBAY_REDIRECT_URI=https://YOUR_DOMAIN/api/ebay/callback
EBAY_VERIFICATION_TOKEN=

# -----------------------------------------------------------------------------
# AWS S3 - Image Uploads (OPTIONAL)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_BUCKET_NAME=

# -----------------------------------------------------------------------------
# EMAIL - Email Notifications (OPTIONAL)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@relist.app

# -----------------------------------------------------------------------------
# AI PROVIDERS - AI Description Generation (OPTIONAL)
# -----------------------------------------------------------------------------
# Get free key at: https://console.groq.com
GROQ_API_KEY=

# Get free key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
